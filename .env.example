# Public browser/desktop configuration. Never put credentials in VITE_*.
VITE_CONVEX_URL=
VITE_POWERSYNC_URL=
VITE_PUBLIC_APP_URL=

# Convex CLI writes CONVEX_DEPLOYMENT into .env.local during setup.
# Configure JWT_PRIVATE_KEY, JWKS and SITE_URL using Convex Auth's setup tool.
# Set PRINT_WORKER_SECRET only in Convex deployment environment and .env.worker.

# Mac mini worker only. Never commit real values.
CONVEX_URL=
PRINT_WORKER_SECRET=
PRINTER_NAME=
WORKER_ID=workstation-mac-mini
