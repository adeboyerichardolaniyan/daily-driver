{
  "name": "daily-driver",
  "version": "0.1.0",
  "description": "Local-first tasks, focus, and daily briefings.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "print:worker": "node --env-file-if-exists=.env.worker --import tsx scripts/print-worker.ts",
    "test:offline": "TEST_PRODUCTION=1 playwright test",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adeboyerichardolaniyan/daily-driver.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/adeboyerichardolaniyan/daily-driver/issues"
  },
  "homepage": "https://github.com/adeboyerichardolaniyan/daily-driver#readme",
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@powersync/common": "^2.5.0",
    "@powersync/react": "^2.2.0",
    "@powersync/web": "^2.6.0",
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "convex": "^1.49.0",
    "lucide-react": "^1.70.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "convex-test": "^0.0.67",
    "prettier": "^3.9.10",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
